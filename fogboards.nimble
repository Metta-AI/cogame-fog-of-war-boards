version     = "0.1.0"
author      = "daveey"
description = "Fog-of-War Boards: Phantom Tic-Tac-Toe and Dark Hex for the Softmax Coworld platform. Two cogs, one board, and the only way to learn where the enemy is standing is to try to stand there yourself; a policy is just a prompt."
license     = "MIT"

srcDir = "src"

requires "nim >= 2.2.4"
requires "bitworld >= 0.1.0"
requires "mummy >= 0.4.7"
requires "curly >= 1.1.1"
requires "whisky"
